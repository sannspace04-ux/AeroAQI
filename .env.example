# ============================================================
# AeroAQI - Environment Variables Template
#
# INSTRUCTIONS:
#   1. Copy this file to a new file called exactly ".env"
#      in the same directory (project root).
#   2. Fill in your real API keys.
#   3. NEVER commit the .env file to git.
#      It is already listed in .gitignore.
# ============================================================

# ------------------------------------------------------------------
# OpenAQ API
# Register free at: https://api.openaq.org/register
# After registration, your API key appears in your account dashboard.
# ------------------------------------------------------------------
OPENAQ_API_KEY=your_openaq_api_key_here

# ------------------------------------------------------------------
# NASA FIRMS (Fire Information for Resource Management System)
# Register free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Use your NASA Earthdata account (or create one free at urs.earthdata.nasa.gov)
# ------------------------------------------------------------------
FIRMS_MAP_KEY=your_firms_map_key_here

# ------------------------------------------------------------------
# Copernicus Climate Data Store (CDS) - for ERA5 data
# Register free at: https://cds.climate.copernicus.eu
# After login, find your API key at: https://cds.climate.copernicus.eu/profile
# The cdsapi library reads ~/.cdsapirc automatically once configured,
# but we also support reading the key from here for portability.
# ------------------------------------------------------------------
CDS_API_KEY=your_cds_uid:your_cds_api_key_here
CDS_API_URL=https://cds.climate.copernicus.eu/api

# ------------------------------------------------------------------
# Open-Meteo (Weather + Air Quality)
# NO API KEY REQUIRED for non-commercial use.
# These variables are kept here only for documentation.
# ------------------------------------------------------------------
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_AQ_BASE_URL=https://air-quality-api.open-meteo.com/v1

# ------------------------------------------------------------------
# Database
# For development, SQLite is used (no server needed).
# Change to a PostgreSQL URI in production:
#   postgresql://user:password@localhost:5432/aeroaqi
# ------------------------------------------------------------------
DATABASE_URL=sqlite:///data/db/aeroaqi.db

# ------------------------------------------------------------------
# General settings
# ------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Root directory for raw data storage (relative to project root)
RAW_DATA_DIR=data/raw

# Root directory for processed data (relative to project root)
PROCESSED_DATA_DIR=data/processed
